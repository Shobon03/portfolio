---
import BaseLayout from '../layouts/BaseLayout.astro';
import SoftCard from '../components/SoftCard.astro';
import {
  GraduationCap,
  ChevronRight,
  Cpu,
  Terminal,
  Cloud,
  CodeIcon,
} from '@lucide/astro';
import {
  Typescript,
  Go,
  Elixir,
  Rust,
  React,
  Vite,
  Expo,
  Tauri,
  Nodedotjs,
  Bun,
  Fastify,
  Springboot,
  Postgresql,
  Mysql,
  Prisma,
  Drizzle,
  Nginx,
  Docker,
  Fedora,
  Linuxmint,
  Android,
  Openjdk,
  Zedindustries,
  Astro as AstroIcon,
} from 'simple-icons-astro';
import { urls } from '../utils/urls';

const experience = [
  {
    company: 'IngenioLab',
    role: 'Full-Stack Developer',
    period: 'Aug 2023 — Mar 2026',
    description: [
      'Architected and delivered full-stack solutions using Node.js, TypeScript, React, and PHP/Laravel.',
      'Built automated CI/CD pipelines and managed AWS (EC2, S3, RDS) infrastructure.',
      'Developed and published a React Native mobile app with Expo, reaching 1k+ downloads.',
      'Led technical migrations and project management initiatives using Jira/Trello.',
    ],
  },
  {
    company: 'FlixWeb',
    role: 'Web Developer — Intern',
    period: 'May 2022 — Aug 2023',
    description: [
      'Developed and maintained web applications using PHP, HTML5, CSS3, and JavaScript.',
      'Implemented responsive sites optimized for SEO.',
      'Managed PHP hosting/servers via cPanel and AWS (EC2, S3).',
    ],
  },
];

const education = [
  {
    institution: 'Universidade Paulista (UNIP)',
    degree: 'B.S. in Computer Science',
    period: 'Jan 2022 — Jun 2026 (Expected)',
    details: 'Algorithms and Data Structures, Networks, Operating Systems.',
  },
  {
    institution: 'Instituto Federal de São Paulo (IFSP)',
    degree: 'Technician in IT for Internet',
    period: 'Jan 2019 — Dec 2021',
    details: 'Web Development with JavaScript and PHP.',
  },
];

const skillCategories = [
  {
    name: 'Programming Languages',
    skills: [
      { name: 'TypeScript', icon: Typescript, color: 'text-blue-600' },
      { name: 'Rust', icon: Rust, color: 'text-orange-700' },
      { name: 'Go', icon: Go, color: 'text-cyan-600' },
      { name: 'Elixir', icon: Elixir, color: 'text-purple-600' },
      { name: 'Java', icon: Openjdk, color: 'text-red-600' },
    ],
  },
  {
    name: 'Frontend',
    skills: [
      { name: 'React', icon: React, color: 'text-cyan-500' },
      { name: 'Vite', icon: Vite, color: 'text-purple-500' },
      { name: 'React Native', icon: React, color: 'text-blue-400' },
      { name: 'Expo', icon: Expo, color: 'text-gray-800' },
      { name: 'Astro', icon: AstroIcon, color: 'text-cyan-500' },
      { name: 'Tauri', icon: Tauri, color: 'text-yellow-500' },
    ],
  },
  {
    name: 'Backend',
    skills: [
      { name: 'Node.js', icon: Nodedotjs, color: 'text-green-600' },
      { name: 'Bun', icon: Bun, color: 'text-orange-400' },
      { name: 'Fastify', icon: Fastify, color: 'text-gray-800' },
      { name: 'Spring Boot', icon: Springboot, color: 'text-green-500' },
      { name: 'Postgres', icon: Postgresql, color: 'text-blue-400' },
      { name: 'MySQL', icon: Mysql, color: 'text-blue-600' },
      { name: 'Prisma', icon: Prisma, color: 'text-gray-700' },
      { name: 'Drizzle', icon: Drizzle, color: 'text-yellow-600' },
      { name: 'Nginx', icon: Nginx, color: 'text-green-600' },
      { name: 'Docker', icon: Docker, color: 'text-blue-500' },
      { name: 'AWS', icon: Cloud, color: 'text-orange-500' },
    ],
  },

  {
    name: 'Tools && Operating Systems',
    skills: [
      { name: 'Fedora', icon: Fedora, color: 'text-blue-700' },
      { name: 'Linux Mint', icon: Linuxmint, color: 'text-green-500' },
      { name: 'Android', icon: Android, color: 'text-green-400' },
      { name: 'Zed', icon: Zedindustries, color: 'text-gray-800' },
    ],
  },
];

const funFacts: string[] = [
  'Linux enthusiast since 2019.',
  'Retro gaming & homebrew dev.',
  'Synthwave & Retrowave music fan.',
  "I've been playing and messing with SMW Hacking since 2008.",
];
---

<BaseLayout title='shobon03 | About Me'>
  <div class='space-y-6 pb-8'>
    <!-- Header Summary -->
    <SoftCard title='System Information: Overview'>
      <div class='flex flex-col gap-6 md:flex-row md:items-center'>
        <div class='relative h-32 w-32 shrink-0 self-center md:self-start'>
          <div
            class='overflow-hidden rounded-full border-4 border-white shadow-lg'
          >
            <img
              src={urls.avatar}
              alt='Matheus Piovezan Teixeira'
              class='h-full w-full object-cover'
            />
          </div>
          <div
            class='absolute -right-1 -bottom-1 flex h-8 w-8 items-center justify-center rounded-full bg-purple-500 text-white shadow-md'
          >
            <Terminal size={16} />
          </div>
        </div>
        <div class='flex-1 space-y-3 text-center md:text-left'>
          <p class='text-2xl'>
            I'm <span class='font-bricolage font-bold'>Matheus</span>, but you
            can call me
            <span class='font-bricolage font-bold'>syobon.</span>
          </p>
          <p class='font-mono text-sm font-bold text-blue-600 uppercase'>
            Full-Stack Developer • Systems Enthusiast
          </p>
          <p class='text-sm leading-relaxed text-gray-700'>
            Dedicated developer based in Brazil. I specialize in building
            scalable cloud-native applications and love diving into low-level
            systems and open-source projects.
          </p>
        </div>
      </div>
    </SoftCard>

    <div class='grid grid-cols-1 gap-6 lg:grid-cols-3'>
      <!-- Left Column: Experience & Education -->
      <div class='space-y-6 lg:col-span-2'>
        <!-- Experience -->
        <SoftCard title='History: Professional Journey'>
          <div>
            {
              experience.map((item) => (
                <div class='relative pb-6 pl-6 before:absolute before:top-1.5 before:left-0 before:h-full before:w-px before:bg-gray-200 last:pb-0'>
                  <div class='absolute top-1.5 -left-1 h-2 w-2 rounded-full bg-blue-500' />
                  <div class='flex flex-col justify-between sm:flex-row sm:items-center'>
                    <h3 class='font-bricolage text-lg font-bold text-gray-800'>
                      {item.role}
                    </h3>
                    <span class='font-mono text-[10px] font-bold text-gray-500 uppercase'>
                      {item.period}
                    </span>
                  </div>
                  <p class='mb-3 font-bold text-blue-700'>{item.company}</p>
                  <ul class='space-y-1'>
                    {item.description.map((desc) => (
                      <li class='flex items-start gap-2 text-sm text-gray-700'>
                        <ChevronRight
                          size={14}
                          class='mt-1 shrink-0 text-gray-400'
                        />
                        <span>{desc}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </SoftCard>

        <!-- Education -->
        <SoftCard title='Academic: Formative Years'>
          <div class='space-y-6'>
            {
              education.map((item) => (
                <div class='flex items-start gap-4'>
                  <div class='flex h-10 w-10 shrink-0 items-center justify-center rounded-xs border border-gray-200 bg-gray-50'>
                    <GraduationCap size={20} class='text-gray-600' />
                  </div>
                  <div class='space-y-1'>
                    <div class='flex flex-col justify-between sm:flex-row sm:items-center'>
                      <h3 class='font-bricolage font-bold text-gray-800'>
                        {item.institution}
                      </h3>
                      <span class='font-mono text-[10px] font-bold text-gray-500 uppercase'>
                        {item.period}
                      </span>
                    </div>
                    <p class='text-sm font-medium text-blue-700'>
                      {item.degree}
                    </p>
                    <p class='text-xs text-gray-600 italic'>{item.details}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </SoftCard>
      </div>

      <!-- Right Column: Skills, Languages, Fun Facts -->
      <div class='space-y-6'>
        <SoftCard title='Software: Tech Stack'>
          <!-- Tech Stack -->
          {
            skillCategories.map((category) => (
              <div class='mb-6 last:mb-0'>
                <h2 class='mb-4 text-sm font-bold text-gray-600'>
                  {category.name}
                </h2>
                <div class='grid grid-cols-4 gap-4 md:grid-cols-8 lg:grid-cols-4'>
                  {category.skills.map((skill) => (
                    <div class='group flex flex-col items-center gap-2'>
                      <div class='flex h-10 w-10 items-center justify-center rounded-xs border border-gray-100 bg-white shadow-sm transition-all group-hover:scale-110 group-hover:border-blue-200 group-hover:shadow-md'>
                        {skill.icon && (
                          <skill.icon size={20} class='text-gray-800' />
                        )}
                      </div>
                      <span class='text-center text-[8px] font-bold tracking-tighter text-gray-600 uppercase'>
                        {skill.name}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            ))
          }
        </SoftCard>

        <!-- Modules: Languages -->
        <SoftCard title='Modules: Languages'>
          <div class='space-y-4'>
            <div class='space-y-1'>
              <div class='flex items-center justify-between'>
                <span class='text-[11px] font-bold text-gray-700 uppercase'>
                  Portuguese
                </span>
                <span class='font-mono text-[10px] font-bold text-blue-600'>
                  NATIVE
                </span>
              </div>
              <div
                class='h-1.5 w-full overflow-hidden rounded-full bg-gray-100'
              >
                <div class='h-full w-full bg-blue-500'></div>
              </div>
            </div>
            <div class='space-y-1'>
              <div class='flex items-center justify-between'>
                <span class='text-[11px] font-bold text-gray-700 uppercase'>
                  English
                </span>
                <span class='font-mono text-[10px] font-bold text-blue-600'>
                  C2 PROFICIENT
                </span>
              </div>
              <div
                class='h-1.5 w-full overflow-hidden rounded-full bg-gray-100'
              >
                <div class='h-full w-[95%] bg-blue-500'></div>
              </div>
            </div>
            <div class='space-y-1'>
              <div class='flex items-center justify-between'>
                <span class='text-[11px] font-bold text-gray-700 uppercase'>
                  Mandarin
                </span>
                <span class='font-mono text-[10px] font-bold text-gray-400'>
                  LEARNING
                </span>
              </div>
              <div
                class='h-1.5 w-full overflow-hidden rounded-full bg-gray-100'
              >
                <div class='h-full w-[15%] bg-blue-300'></div>
              </div>
            </div>
          </div>
        </SoftCard>

        <!-- Cache: Currently Learning -->
        <SoftCard title='Cache: Currently Learning'>
          <ul class='space-y-3'>
            <li class='flex items-start gap-3'>
              <Cpu size={16} class='mt-0.5 text-orange-500' />
              <div class='space-y-0.5'>
                <p class='text-xs font-bold text-gray-800 uppercase'>
                  SNES Assembly
                </p>
                <p class='text-[11px] text-gray-600'>
                  Retro game modding (SMW)
                </p>
              </div>
            </li>
            <li class='flex items-start gap-3'>
              <CodeIcon size={16} class='mt-0.5 text-blue-500' />
              <div class='space-y-0.5'>
                <p class='text-xs font-bold text-gray-800 uppercase'>
                  Systems Languages
                </p>
                <p class='text-[11px] text-gray-600'>Rust, Go, and Elixir</p>
              </div>
            </li>
          </ul>
        </SoftCard>

        <!-- Misc: Fun Facts -->
        <SoftCard title='Misc: Fun Facts'>
          <ul class='space-y-3'>
            {
              funFacts.map((fact) => (
                <li class='flex items-start gap-2 text-xs text-gray-700'>
                  <div class='mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-500' />
                  <span>{fact}</span>
                </li>
              ))
            }
          </ul>
        </SoftCard>
      </div>
    </div>
  </div>
</BaseLayout>
