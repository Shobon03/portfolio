---
import BaseLayout from '../layouts/BaseLayout.astro';
import SoftCard from '../components/SoftCard.astro';
import SoftButton from '../components/SoftButton.astro';
import {
  GraduationCap,
  ChevronRight,
  Cpu,
  Terminal,
  Cloud,
  CodeIcon,
  Mail,
} from '@lucide/astro';
import {
  Typescript,
  Go,
  Elixir,
  Rust,
  React,
  Vite,
  Expo,
  Tauri,
  Nodedotjs,
  Bun,
  Fastify,
  Springboot,
  Postgresql,
  Mysql,
  Prisma,
  Drizzle,
  Nginx,
  Docker,
  Fedora,
  Linuxmint,
  Android,
  Openjdk,
  Zedindustries,
  Astro as AstroIcon,
  Github,
  Php,
} from 'simple-icons-astro';
import { urls } from '../utils/urls';
import { Image } from 'astro:assets';
import email from '../assets/images/email.png';

const experience = [
  {
    company: 'IngenioLab',
    role: 'Full-Stack Developer',
    period: 'Aug 2023 — Mar 2026',
    description: [
      'Architected and delivered full-stack solutions using Node.js, TypeScript, React, and PHP/Laravel.',
      'Built automated CI/CD pipelines and managed AWS (EC2, S3, RDS) infrastructure.',
      'Developed and published a React Native mobile app with Expo, reaching 1k+ downloads.',
      'Led technical migrations and project management initiatives using Jira/Trello.',
    ],
  },
  {
    company: 'FlixWeb',
    role: 'Web Developer — Intern',
    period: 'May 2022 — Aug 2023',
    description: [
      'Developed and maintained web applications using PHP, HTML5, CSS3, and JavaScript.',
      'Implemented responsive sites optimized for SEO.',
      'Managed PHP hosting/servers via cPanel and AWS (EC2, S3).',
    ],
  },
];

const education = [
  {
    institution: 'Universidade Paulista (UNIP)',
    degree: 'B.S. in Computer Science',
    period: 'Jan 2022 — Jun 2026 (Expected)',
    details: 'Algorithms and Data Structures, Networks, Operating Systems.',
  },
  {
    institution: 'Instituto Federal de São Paulo (IFSP)',
    degree: 'Technician in Web Developent',
    period: 'Jan 2019 — Dec 2021',
    details: 'Web Development with JavaScript and PHP.',
  },
];

const skillCategories = [
  {
    name: 'Programming Languages',
    skills: [
      { name: 'TypeScript', icon: Typescript },
      { name: 'PHP', icon: Php },
      { name: 'Rust', icon: Rust },
      { name: 'Go', icon: Go },
      { name: 'Elixir', icon: Elixir },
      { name: 'Java', icon: Openjdk },
    ],
  },
  {
    name: 'Frontend',
    skills: [
      { name: 'React', icon: React },
      { name: 'Vite', icon: Vite },
      { name: 'React Native', icon: React },
      { name: 'Expo', icon: Expo },
      { name: 'Astro', icon: AstroIcon },
      { name: 'Tauri', icon: Tauri },
    ],
  },
  {
    name: 'Backend',
    skills: [
      { name: 'Node.js', icon: Nodedotjs },
      { name: 'Bun', icon: Bun },
      { name: 'Fastify', icon: Fastify },
      { name: 'Spring Boot', icon: Springboot },
      { name: 'Postgres', icon: Postgresql },
      { name: 'MySQL', icon: Mysql },
      { name: 'Prisma', icon: Prisma },
      { name: 'Drizzle', icon: Drizzle },
      { name: 'Nginx', icon: Nginx },
      { name: 'Docker', icon: Docker },
      { name: 'AWS', icon: Cloud },
      { name: 'Azure', icon: Cloud },
    ],
  },

  {
    name: 'Tools && Operating Systems',
    skills: [
      { name: 'Fedora', icon: Fedora, color: 'text-blue-700' },
      { name: 'Linux Mint', icon: Linuxmint, color: 'text-green-500' },
      { name: 'Android', icon: Android, color: 'text-green-400' },
      { name: 'Zed', icon: Zedindustries, color: 'text-gray-800' },
    ],
  },
];

const funFacts: string[] = [
  'Linux enthusiast since 2019.',
  'Retro gaming & homebrew dev.',
  'Synthwave & Retrowave music fan.',
  "I've been playing and messing with SMW Hacking since 2008.",
];
---

<BaseLayout title='shobon03 | About Me'>
  <div class='space-y-6'>
    <!-- Header Summary -->
    <SoftCard title='System Information: Overview'>
      <div class='flex flex-col gap-6 md:flex-row md:items-center'>
        <div class='relative size-32 shrink-0 self-center md:self-start'>
          <div
            class='overflow-hidden rounded-full border-4 border-white shadow-lg'>
            <Image
              src={urls.avatar}
              alt="shobon03's avatar"
              class='h-full w-full object-cover'
              width='128'
              height='128'
            />
          </div>
          <div
            class='absolute -right-1 -bottom-1 flex h-8 w-8 items-center justify-center rounded-full bg-purple-500 text-white shadow-md'>
            <Terminal size={16} />
          </div>
        </div>
        <div class='flex-1 space-y-3 text-center md:text-left'>
          <p class='text-2xl'>
            I'm <span class='font-bricolage font-bold'>Matheus</span>, but you
            can call me
            <span class='font-bricolage font-bold'>shobon03</span>.
          </p>
          <p class='font-mono text-sm font-bold text-blue-600 uppercase'>
            Full-Stack Developer • Systems Enthusiast
          </p>
          <p class='text-sm leading-relaxed text-gray-700'>
            Dedicated developer based in Brazil. I specialize in building
            scalable cloud-native applications and love diving into low-level
            systems and open-source projects.
          </p>
        </div>
        <div class='grid grid-cols-1 gap-2'>
          <SoftButton
            href={urls.github}
            target='_blank'
            class='w-full justify-center gap-2'>
            <Github size={14} /> GitHub Profile
          </SoftButton>
          <SoftButton
            href={urls.linkedin}
            target='_blank'
            class='w-full justify-center gap-2'>
            <svg
              width='14px'
              height='14px'
              viewBox='0 0 256 256'
              xmlns='http://www.w3.org/2000/svg'>
              <g fill='none'>
                <path
                  d='M0 18.338C0 8.216 8.474 0 18.92 0h218.16C247.53 0 256 8.216 256 18.338v219.327C256 247.79 247.53 256 237.08 256H18.92C8.475 256 0 247.791 0 237.668V18.335z'
                  fill='#1c398e'>
                </path>
                <path
                  d='M77.796 214.238V98.986H39.488v115.252H77.8zM58.65 83.253c13.356 0 21.671-8.85 21.671-19.91-.25-11.312-8.315-19.915-21.417-19.915-13.111 0-21.674 8.603-21.674 19.914 0 11.06 8.312 19.91 21.169 19.91h.248zM99 214.238h38.305v-64.355c0-3.44.25-6.889 1.262-9.346 2.768-6.885 9.071-14.012 19.656-14.012 13.858 0 19.405 10.568 19.405 26.063v61.65h38.304v-66.082c0-35.399-18.896-51.872-44.099-51.872-20.663 0-29.738 11.549-34.78 19.415h.255V98.99H99.002c.5 10.812-.003 115.252-.003 115.252z'
                  fill='#ffffff'>
                </path>
              </g>
            </svg>
            LinkedIn Profile
          </SoftButton>
          <SoftButton
            id='email-btn'
            class='w-full cursor-pointer justify-center gap-2'>
            <Mail size={14} />
            Send me an E-mail
          </SoftButton>
        </div>
      </div>
    </SoftCard>

    <div class='grid grid-cols-1 gap-6 lg:grid-cols-3'>
      <!-- Left Column: Experience & Education -->
      <div class='space-y-6 lg:col-span-2'>
        <!-- Experience -->
        <SoftCard title='History: Professional Journey'>
          <div>
            {
              experience.map((item) => (
                <div class='relative pb-6 pl-6 before:absolute before:top-1.5 before:left-0 before:h-full before:w-px before:bg-gray-200 last:pb-0'>
                  <div class='absolute top-1.5 -left-1 h-2 w-2 rounded-full bg-blue-500' />
                  <div class='flex flex-col justify-between sm:flex-row sm:items-center'>
                    <h3 class='font-bricolage text-lg font-bold text-gray-800'>
                      {item.role}
                    </h3>
                    <span class='font-mono text-[10px] font-bold text-gray-500 uppercase'>
                      {item.period}
                    </span>
                  </div>
                  <p class='mb-3 font-bold text-blue-700'>{item.company}</p>
                  <ul class='space-y-1'>
                    {item.description.map((desc) => (
                      <li class='flex items-start gap-2 text-sm text-gray-700'>
                        <ChevronRight
                          size={14}
                          class='mt-1 shrink-0 text-gray-400'
                        />
                        <span>{desc}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </SoftCard>

        <!-- Education -->
        <SoftCard title='Academic: Formative Years'>
          <div class='space-y-6'>
            {
              education.map((item) => (
                <div class='flex items-start gap-4'>
                  <div class='flex h-10 w-10 shrink-0 items-center justify-center rounded-xs border border-gray-200 bg-gray-50'>
                    <GraduationCap size={20} class='text-gray-600' />
                  </div>
                  <div class='flex-1 space-y-1'>
                    <div class='flex flex-col justify-between gap-5 sm:flex-row sm:items-center'>
                      <h3 class='font-bricolage font-bold text-gray-800'>
                        {item.institution}
                      </h3>
                      <span class='font-mono text-[10px] font-bold text-gray-500 uppercase'>
                        {item.period}
                      </span>
                    </div>
                    <p class='text-sm font-medium text-blue-700'>
                      {item.degree}
                    </p>
                    <p class='text-xs text-gray-600 italic'>{item.details}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </SoftCard>
      </div>

      <!-- Right Column: Skills, Languages, Fun Facts -->
      <div class='space-y-6'>
        <SoftCard title='Software: Tech Stack'>
          <!-- Tech Stack -->
          {
            skillCategories.map((category) => (
              <div class='mb-6 last:mb-0'>
                <h2 class='mb-4 text-sm font-bold text-gray-600'>
                  {category.name}
                </h2>
                <div class='grid grid-cols-4 gap-4 md:grid-cols-8 lg:grid-cols-4'>
                  {category.skills.map((skill) => (
                    <div class='group flex flex-col items-center gap-2'>
                      <div class='flex h-10 w-10 items-center justify-center rounded-xs border border-gray-100 bg-white shadow-sm transition-all group-hover:scale-110 group-hover:border-blue-200 group-hover:shadow-md'>
                        {skill.icon && (
                          <skill.icon size={20} class='text-gray-800' />
                        )}
                      </div>
                      <span class='text-center text-[8px] font-bold tracking-tighter text-gray-600 uppercase'>
                        {skill.name}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            ))
          }
        </SoftCard>

        <!-- Modules: Languages -->
        <SoftCard title='Modules: Languages'>
          <div class='space-y-4'>
            <div class='space-y-1'>
              <div class='flex items-center justify-between'>
                <span class='text-[11px] font-bold text-gray-700 uppercase'>
                  Portuguese
                </span>
                <span class='font-mono text-[10px] font-bold text-blue-600'>
                  NATIVE
                </span>
              </div>
              <div
                class='h-1.5 w-full overflow-hidden rounded-full bg-gray-100'>
                <div class='h-full w-full bg-blue-500'></div>
              </div>
            </div>
            <div class='space-y-1'>
              <div class='flex items-center justify-between'>
                <span class='text-[11px] font-bold text-gray-700 uppercase'>
                  English
                </span>
                <span class='font-mono text-[10px] font-bold text-blue-600'>
                  C2 PROFICIENT
                </span>
              </div>
              <div
                class='h-1.5 w-full overflow-hidden rounded-full bg-gray-100'>
                <div class='h-full w-[95%] bg-blue-500'></div>
              </div>
            </div>
            <div class='space-y-1'>
              <div class='flex items-center justify-between'>
                <span class='text-[11px] font-bold text-gray-700 uppercase'>
                  Mandarin
                </span>
                <span class='font-mono text-[10px] font-bold text-gray-400'>
                  LEARNING
                </span>
              </div>
              <div
                class='h-1.5 w-full overflow-hidden rounded-full bg-gray-100'>
                <div class='h-full w-[15%] bg-blue-300'></div>
              </div>
            </div>
          </div>
        </SoftCard>

        <!-- Cache: Currently Learning -->
        <SoftCard title='Cache: Currently Learning'>
          <ul class='space-y-3'>
            <li class='flex items-start gap-3'>
              <Cpu size={16} class='mt-0.5 text-orange-500' />
              <div class='space-y-0.5'>
                <p class='text-xs font-bold text-gray-800 uppercase'>
                  SNES Assembly
                </p>
                <p class='text-[11px] text-gray-600'>
                  Retro game modding (SMW)
                </p>
              </div>
            </li>
            <li class='flex items-start gap-3'>
              <CodeIcon size={16} class='mt-0.5 text-blue-500' />
              <div class='space-y-0.5'>
                <p class='text-xs font-bold text-gray-800 uppercase'>
                  Systems Languages
                </p>
                <p class='text-[11px] text-gray-600'>Rust, Go, and Elixir</p>
              </div>
            </li>
          </ul>
        </SoftCard>

        <!-- Misc: Fun Facts -->
        <SoftCard title='Misc: Fun Facts'>
          <ul class='space-y-3'>
            {
              funFacts.map((fact) => (
                <li class='flex items-start gap-2 text-xs text-gray-700'>
                  <div class='mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-500' />
                  <span>{fact}</span>
                </li>
              ))
            }
          </ul>
        </SoftCard>
      </div>
    </div>

    <!-- Email Modal -->
    <dialog
      id='email-modal'
      class='m-auto w-full max-w-md border-none bg-transparent p-4 outline-none backdrop:bg-black/50'>
      <SoftCard title='Send me an E-mail'>
        <div class='space-y-4'>
          <div class='text-gray-700'>
            <p class='text-xs'>
              If you want to contact me, feel free to send me an email at:
            </p>
            <Image src={email} alt='My email address.' class='py-2' />
            <p class='text-xs'>Replace GOOGLEMAIL with GMAIL.</p>
          </div>
          <div class='flex justify-end border-t border-gray-100 pt-4'>
            <SoftButton id='close-email-modal-btn' variant='secondary'>
              Dismiss
            </SoftButton>
          </div>
        </div>
      </SoftCard>
    </dialog>
  </div>

  <script>
    // Email Modal Logic
    const emailBtn = document.getElementById('email-btn');
    const closeEmailBtn = document.getElementById('close-email-modal-btn');
    const emailModal = document.getElementById(
      'email-modal',
    ) as HTMLDialogElement;

    if (emailBtn && emailModal && closeEmailBtn) {
      emailBtn.addEventListener('click', () => {
        emailModal.showModal();
      });

      closeEmailBtn.addEventListener('click', () => {
        emailModal.close();
      });

      // Close on backdrop click
      emailModal.addEventListener('click', (e) => {
        if (e.target === emailModal) {
          emailModal.close();
        }
      });
    }
  </script>
</BaseLayout>
