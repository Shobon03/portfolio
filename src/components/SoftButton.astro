---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
	variant?: "primary" | "secondary";
}

const { variant = "primary", class: className, ...attrs } = Astro.props;
const Tag = attrs.href ? "a" : "button";
---
<Tag
  {...attrs}
  class:list={[
    "inline-flex items-center justify-center px-4 py-1.5 rounded-xs font-bold text-[11px] shadow-(--shadow-web2) border transition-all active:shadow-(--shadow-inset-panel) active:translate-y-px no-underline cursor-pointer",
    variant === 'primary'
      ? "bg-linear-to-b from-[#FFFFFF] to-[#E5E7EB] border-gray-400 text-blue-900 hover:border-gray-500"
      : "bg-linear-to-b from-copper to-[#A85215] border-[#8C4610] text-white",
    className
  ]}
>
  <slot />
</Tag>
